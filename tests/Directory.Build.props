<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="MSTest" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectName) == 'Winland.Application.Tests' Or $(MSBuildProjectName) == 'Winland.Domain.Tests' Or $(MSBuildProjectName) == 'Winland.Infrastructure.Tests' Or $(MSBuildProjectName) == 'Winland.Install.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)TestSequence.cs" Link="TestSequence.cs" />
  </ItemGroup>
</Project>
