<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Winland.Application\Winland.Application.csproj" />
    <Using Include="Winland.Domain" />
    <Using Include="Winland.Domain.Monitor" Alias="Monitor" />
    <Using Include="Winland.Application" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winland.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SHAppBarMessage's struct is pointer-sized, so CsWin32 will not emit it for AnyCPU. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

</Project>
